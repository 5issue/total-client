# ─────────────────────────────────────────────────────────────
# 브라우저에 노출됨 (NEXT_PUBLIC_ 접두어)
# ⚠️ 빌드 타임에 번들로 인라인된다. 배포 후 ConfigMap 을 바꿔도 반영되지 않는다.
#    값을 바꾸려면 이미지를 다시 빌드해야 한다 (Dockerfile builder ARG).
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=local

# ─────────────────────────────────────────────────────────────
# 서버 전용 (NEXT_PUBLIC_ 접두어 없음)
# 브라우저 번들에 포함되지 않는다. 런타임에 K8s ConfigMap/Secret 으로 주입 가능.
# 배포 환경은 인그레스가 단일 도메인에서 서비스별 경로를 라우팅한다고 가정한다.
# 로컬은 게이트웨이가 없고 서비스별로 포트가 분리돼 있으므로(total-backend), 이 계약을
# 유지하려면 `npm run dev:gateway`(scripts/local-gateway.mjs)를 먼저 띄워야 한다 — 기본
# 포트가 4000이라 아래 기본값과 맞는다. (auth-service 처럼 서비스 하나만 볼 때는 그 포트로
# 직접 바꿔도 되지만, 그러면 다른 도메인 호출은 404가 난다.)
# ─────────────────────────────────────────────────────────────
API_INTERNAL_URL=http://localhost:4000

# 로컬 전용. Spring 백엔드 미배포 구간을 MSW 로 목킹할지 여부 — "enabled" 로 설정하면
# Route Handler 가 호출하는 외부 API 를 MSW 가 가로챈다(src/instrumentation.ts). 빈 값이면 항상 꺼짐.
API_MOCKING=

# 로컬 전용. 실기기(폰)에서 같은 네트워크의 맥/PC IP로 dev 서버 접속 테스트할 때만
# 설정한다(`ipconfig getifaddr en0` 등으로 확인). 비워두면 LAN 접속이 꺼진다 —
# IP가 달라 값을 공유하지 않는다.
DEV_LAN_IP=
